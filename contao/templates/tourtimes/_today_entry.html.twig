{# Ein Eintrag der Tagesliste. Erwartet: entry, labels #}
<time class="tourtimes-today__time" datetime="{{ entry.start|date('Y-m-d\\TH:i') }}">
  {{- entry.start|date('H:i') }}{% if labels.time_suffix %} {{ labels.time_suffix }}{% endif -%}
</time>

<span class="tourtimes-today__offer">
  {%- if entry.offer.url %}<a href="{{ entry.offer.url }}">{{ entry.offer.title }}</a>{% else %}{{ entry.offer.title }}{% endif -%}
</span>

{% if entry.offer.meetingPoint %}
  <span class="tourtimes-today__meeting-point">{{ labels.meeting_point }}: {{ entry.offer.meetingPoint }}</span>
{% endif %}

{% if entry.cancelled %}
  <span class="tourtimes-badge tourtimes-badge--cancelled">{{ labels.cancelled }}</span>
{% elseif entry.changed %}
  <span class="tourtimes-badge tourtimes-badge--changed">{{ labels.changed }}</span>
  {% if entry.originalStart %}<span class="tourtimes-date__original">{{ labels.changed_from }} {{ entry.originalStart|date('H:i') }}</span>{% endif %}
{% elseif entry.extra %}
  <span class="tourtimes-badge tourtimes-badge--extra">{{ labels.extra }}</span>
{% endif %}

{% for note in entry.notes %}
  <span class="tourtimes-date__note">{{ note }}</span>
{% endfor %}
